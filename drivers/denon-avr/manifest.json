{
  "id": "denon-avr",
  "displayName": "Denon / Marantz AVR",
  "icon": "🔊",
  "version": "0.1.0",
  "category": "media",
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "telnet",
        "label": "Network Control (Telnet)",
        "transport": "tcp",
        "fields": [
          { "key": "host", "type": "string", "label": "Receiver IP address" },
          { "key": "port", "type": "number", "label": "Port", "default": 23 }
        ]
      }
    ]
  },
  "settings": [],
  "actions": [
    { "id": "turnOn", "label": "Turn On", "role": "on", "params": [] },
    { "id": "turnOff", "label": "Standby", "role": "off", "params": [] },
    {
      "id": "setVolume",
      "label": "Set Volume",
      "role": "level",
      "params": [{ "key": "value", "type": "number", "min": 0, "max": 100 }]
    },
    { "id": "mute", "label": "Mute", "params": [] },
    { "id": "unmute", "label": "Unmute", "params": [] },
    { "id": "setInput", "label": "Set Input", "params": [{ "key": "input", "type": "string", "label": "e.g. CD, TUNER, DVD, BD, GAME, AUX1, NET" }] }
  ],
  "events": [],
  "states": [
    { "id": "power.on", "type": "boolean", "role": "on" },
    { "id": "power.volume", "type": "number", "role": "level" },
    { "id": "power.muted", "type": "boolean" },
    { "id": "power.input", "type": "string" }
  ]
}
