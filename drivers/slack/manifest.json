{
  "id": "slack",
  "displayName": "Slack",
  "version": "0.1.0",
  "category": "generic",
  "connection": {
    "kind": "choice",
    "options": [{ "id": "cloud", "label": "Slack Incoming Webhook", "transport": "http", "fields": [] }]
  },
  "settings": [
    { "key": "webhookUrl", "type": "password", "label": "Incoming Webhook URL (Slack app settings -> Incoming Webhooks -> Add New Webhook to Workspace)" }
  ],
  "actions": [
    {
      "id": "sendMessage",
      "label": "Send Message",
      "params": [
        { "key": "text", "type": "string", "label": "Message" },
        { "key": "channel", "type": "string", "label": "Channel override (optional, e.g. #alerts - only works if the webhook allows it)" }
      ]
    }
  ],
  "events": [
    { "id": "messageSent", "label": "Message Sent", "params": ["text"] },
    { "id": "sendFailed", "label": "Send Failed", "params": ["error"] }
  ],
  "states": [
    { "id": "lastMessage", "type": "string" },
    { "id": "lastSentAt", "type": "number" }
  ]
}
