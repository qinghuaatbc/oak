{
  "id": "govee-lan",
  "displayName": "Govee (LAN API)",
  "icon": "💡",
  "version": "0.1.0",
  "category": "light",
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "local",
        "label": "Local network (UDP)",
        "transport": "http",
        "fields": [{ "key": "host", "type": "string", "label": "Device IP address" }]
      }
    ]
  },
  "settings": [],
  "actions": [
    { "id": "turnOn", "label": "Turn On", "role": "on", "params": [] },
    { "id": "turnOff", "label": "Turn Off", "role": "off", "params": [] },
    { "id": "setBrightness", "label": "Set Brightness", "role": "level", "params": [{ "key": "value", "type": "number", "min": 0, "max": 100 }] },
    { "id": "refresh", "label": "Refresh Status", "params": [] }
  ],
  "events": [],
  "states": [
    { "id": "device.on", "type": "boolean", "role": "on" },
    { "id": "device.brightness", "type": "number", "role": "level" }
  ]
}
