{
  "id": "philips-hue",
  "displayName": "Philips Hue",
  "version": "0.1.0",
  "category": "light",
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "http",
        "label": "Hue Bridge",
        "transport": "http",
        "fields": [
          { "key": "host", "type": "string", "label": "Bridge IP address" },
          { "key": "port", "type": "number", "label": "Port", "default": 80 }
        ]
      }
    ]
  },
  "settings": [
    { "key": "username", "type": "password", "label": "Application key (press the bridge's Link button, then POST {\"devicetype\":\"oak\"} to http://<bridge>/api once to get this)" },
    { "key": "pollIntervalMs", "type": "number", "label": "Poll interval (ms)", "default": 5000 },
    {
      "key": "lightNames",
      "type": "keyvalue",
      "label": "Light names (Discover devices auto-fills this from the bridge's own names)",
      "keyLabel": "Light ID (e.g. 1)",
      "valueLabel": "Friendly name"
    }
  ],
  "actions": [
    { "id": "lightOn", "label": "Turn On", "role": "on", "params": [{ "key": "lightId", "type": "string", "label": "Light ID" }] },
    { "id": "lightOff", "label": "Turn Off", "role": "off", "params": [{ "key": "lightId", "type": "string", "label": "Light ID" }] },
    {
      "id": "setBrightness",
      "label": "Set Brightness",
      "role": "level",
      "params": [
        { "key": "lightId", "type": "string", "label": "Light ID" },
        { "key": "level", "type": "number", "label": "Level (0-100)", "default": 100 }
      ]
    },
    { "id": "discoverLights", "label": "Discover Lights", "params": [] }
  ],
  "events": [
    { "id": "stateChanged", "label": "State Changed", "params": ["lightId", "on"] },
    { "id": "nodesDiscovered", "label": "Lights Discovered", "params": ["count"] }
  ],
  "states": [
    { "id": "light.on", "type": "boolean", "role": "on", "perInstance": "lightId" },
    { "id": "light.level", "type": "number", "role": "level", "perInstance": "lightId" },
    { "id": "discovery.nodes", "type": "string" }
  ]
}
