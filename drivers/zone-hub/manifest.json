{
  "id": "zone-hub",
  "displayName": "Multi-Zone Light + Climate Hub",
  "version": "0.1.0",
  "category": ["light", "climate"],
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "http",
        "label": "HTTP",
        "transport": "http",
        "fields": [
          { "key": "host", "type": "string", "label": "Hub IP address" },
          { "key": "port", "type": "number", "label": "Port", "default": 80 }
        ]
      }
    ]
  },
  "settings": [
    { "key": "pollIntervalMs", "type": "number", "label": "Status poll interval (ms)", "default": 3000 },
    {
      "key": "zoneNames",
      "type": "keyvalue",
      "label": "Zone names",
      "keyLabel": "Zone id (e.g. kitchen)",
      "valueLabel": "Friendly name (e.g. Kitchen)"
    }
  ],
  "actions": [
    { "id": "lightOn", "label": "Light On", "role": "on", "params": [{ "key": "zone", "type": "string", "label": "Zone" }] },
    { "id": "lightOff", "label": "Light Off", "role": "off", "params": [{ "key": "zone", "type": "string", "label": "Zone" }] },
    {
      "id": "lightSetLevel",
      "label": "Light Set Level",
      "role": "level",
      "params": [
        { "key": "zone", "type": "string", "label": "Zone" },
        { "key": "level", "type": "number", "label": "Level (0-100)", "default": 100 }
      ]
    },
    {
      "id": "climateSetTarget",
      "label": "Climate Set Target",
      "params": [
        { "key": "zone", "type": "string", "label": "Zone" },
        { "key": "target", "type": "number", "label": "Target (°F)", "default": 70 }
      ]
    }
  ],
  "events": [{ "id": "stateChanged", "label": "State Changed", "params": ["zone", "field", "value"] }],
  "states": [
    { "id": "light.on", "type": "boolean", "role": "on", "perInstance": "zone" },
    { "id": "light.level", "type": "number", "role": "level", "perInstance": "zone" },
    { "id": "climate.target", "type": "number", "perInstance": "zone" }
  ]
}
