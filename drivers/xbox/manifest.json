    { "id": "turnOff", "label": "Power Off", "role": "off", "params": [] },
    { "id": "discoverConsoles", "label": "Discover Consoles", "params": [] }
  ],
  "events": [],
  "states": [{ "id": "discovery.consoles", "type": "string" }]
