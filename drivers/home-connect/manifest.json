{
  "id": "home-connect",
  "displayName": "Home Connect (Bosch/Siemens)",
  "icon": "🏠",
  "version": "0.1.0",
  "category": "generic",
  "connection": {
    "kind": "choice",
    "options": [{ "id": "cloud", "label": "Home Connect API", "transport": "http", "fields": [] }]
  },
  "settings": [
    { "key": "clientId", "type": "string", "label": "Client id (developer.home-connect.com)" },
    { "key": "clientSecret", "type": "password", "label": "Client secret" },
    { "key": "refreshToken", "type": "password", "label": "Refresh token (from a one-time Authorization Code flow)" },
    { "key": "applianceId", "type": "string", "label": "Appliance id (haId, from discoverAppliances)" }
