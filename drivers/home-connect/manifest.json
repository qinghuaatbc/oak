  "actions": [
    { "id": "turnOn", "label": "Turn On", "role": "on", "params": [] },
    { "id": "turnOff", "label": "Turn Off (Standby)", "role": "off", "params": [] },
    { "id": "startProgram", "label": "Start Program", "params": [{ "key": "programKey", "type": "string" }] },
    { "id": "stopProgram", "label": "Stop Program", "params": [] },
    { "id": "discoverAppliances", "label": "Discover Appliances", "params": [] },
    { "id": "refresh", "label": "Refresh Status", "params": [] }
  ],
  "events": [],
  "states": [
    { "id": "appliance.powerState", "type": "string" },
    { "id": "appliance.doorState", "type": "string" },
    { "id": "discovery.appliances", "type": "string" }
  ]
