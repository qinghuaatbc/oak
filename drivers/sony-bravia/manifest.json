{
  "id": "sony-bravia",
  "displayName": "Sony Bravia Display (Simple IP Control)",
  "icon": "📺",
  "version": "0.1.0",
  "category": "media",
  "connection": {
    "kind": "tcp",
    "fields": [
      { "key": "host", "type": "string", "label": "Display IP address" },
      { "key": "port", "type": "number", "label": "Port", "default": 20060 }
    ]
  },
  "settings": [],
  "actions": [
    { "id": "powerOn", "label": "Power On", "role": "on", "params": [] },
    { "id": "powerOff", "label": "Power Off", "role": "off", "params": [] },
    { "id": "setInput", "label": "Set Input", "params": [
      { "key": "inputType", "type": "select", "options": ["1", "3", "4", "5"], "label": "1=HDMI 3=Composite 4=Component 5=Screen Mirroring" },
      { "key": "port", "type": "number", "label": "Port number", "default": 1 }
    ] }
  ],
  "events": [],
  "states": [
    { "id": "power", "label": "Power State", "role": "on" }
  ]
}
