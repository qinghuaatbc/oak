{
  "id": "justaddpower",
  "displayName": "Just Add Power (AV-over-IP)",
  "icon": "🔀",
  "version": "0.1.0",
  "category": "generic",
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "unified",
        "label": "Unified Mode (justOS B2.1.0+, HTTP API)",
        "transport": "http",
        "fields": [{ "key": "host", "type": "string", "label": "Decoder IP address" }]
      },
      {
        "id": "flexible",
        "label": "Flexible Mode (AMP-configured, Telnet CLI)",
        "transport": "tcp",
        "fields": [
          { "key": "host", "type": "string", "label": "Decoder IP address" },
          { "key": "port", "type": "number", "label": "Port", "default": 23 }
        ]
      }
    ]
  },
  "settings": [],
  "actions": [
    { "id": "setChannel", "label": "Set Video Channel", "params": [{ "key": "channel", "type": "number", "label": "Channel/input number" }] },
    { "id": "setAudioChannel", "label": "Set Audio Channel (Flexible Mode only)", "params": [{ "key": "channel", "type": "number", "label": "Channel/input number" }] }
  ],
  "events": [],
  "states": []
}
