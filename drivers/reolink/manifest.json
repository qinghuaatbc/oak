{
  "id": "reolink",
  "displayName": "Reolink Camera",
  "icon": "📷",
  "version": "0.1.0",
  "category": "generic",
  "connection": {
    "kind": "choice",
    "options": [
      {
        "id": "local",
        "label": "Local network",
        "transport": "http",
        "fields": [
          { "key": "host", "type": "string", "label": "Camera IP address" },
          { "key": "port", "type": "number", "label": "Port", "default": 80 }
        ]
      }
    ]
  },
  "settings": [
    { "key": "username", "type": "string", "label": "Username", "default": "admin" },
    { "key": "password", "type": "password", "label": "Password" },
    { "key": "channel", "type": "number", "label": "Channel", "default": 0 }
  ],
  "actions": [
    { "id": "ptzMove", "label": "PTZ Move", "params": [{ "key": "direction", "type": "string", "label": "Left/Right/Up/Down/LeftUp/LeftDown/RightUp/RightDown" }, { "key": "speed", "type": "number", "default": 32 }] },
    { "id": "ptzStop", "label": "PTZ Stop", "params": [] },
    { "id": "setIrLights", "label": "Set IR Lights", "params": [{ "key": "state", "type": "string", "label": "Auto / On / Off" }] },
    { "id": "refreshMotion", "label": "Refresh Motion State", "params": [] }
  ],
  "events": [],
  "states": [{ "id": "motion.detected", "type": "boolean" }]
}
